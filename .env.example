# Copy this file to .env and fill in your values.
# .env is git-ignored and must NEVER be committed.

# NVD API key — get one free at https://nvd.nist.gov/developers/request-an-api-key
# Without a key: rate limit = 5 req/30s (very slow)
# With a key:    rate limit = 50 req/30s
NVD_API_KEY=your-nvd-api-key-here

# Optional: Anthropic API key (for AI CPE matching & risk narrative via Claude)
# Leave blank to disable — the tool works without it.
ANTHROPIC_API_KEY=your-anthropic-api-key-here
